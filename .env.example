# Public site URL — used for canonical links, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://templete.kodu.live

# The main Kodu app. "Open in Kodu" sends visitors to $NEXT_PUBLIC_KODU_APP_URL/new?repo=…
NEXT_PUBLIC_KODU_APP_URL=https://kodu.live

# Optional. Set BOTH to have the server provision the workspace through the
# Kodu API instead of handing off by URL. See "Kodu handoff" in the README.
# KODU_API_URL=https://api.kodu.live
# KODU_API_TOKEN=

# Optional. Shown as "Source" in the footer. Left unset the link is omitted,
# rather than pointing visitors at a repository that may not be public.
# NEXT_PUBLIC_SOURCE_URL=https://github.com/OWNER/REPO

# Optional. GitHub organisation holding Kodu's own templates. The ingest walks
# its public repos and picks up any tagged `kodu-template`.
# KODU_TEMPLATES_ORG=

# Optional. A GitHub personal access token (no scopes needed — public data
# only) raises the ingest search rate limit from 10 to 30 requests/minute.
# GITHUB_TOKEN=
